{
  "name": "safe-squad-child-protection-games",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "SAFE SQUAD - a mobile-first child protection game hub for High School / Senior High School students.",
  "scripts": {
    "dev": "vite",
    "dev:server": "node --watch server/index.js",
    "server": "node server/index.js",
    "db:setup": "node server/setup-database.js",
    "db:migrate": "node server/migrate-student-status.js && node server/migrate-sessions.js",
    "test": "node --test tests/security.test.js tests/student-management.test.js tests/reports.test.js tests/deployment.test.js tests/render.test.js",
    "test:management": "node --test tests/student-management.test.js",
    "test:reports": "node --test tests/reports.test.js",
    "test:security": "node --test tests/security.test.js",
    "test:deployment": "node --test tests/deployment.test.js tests/render.test.js",
    "admin:create": "node server/create-admin.js",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "playwright": "^1.49.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "mysql2": "^3.24.6"
  }
}
