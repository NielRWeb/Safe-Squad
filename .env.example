# =========================================================
#  SAFE SQUAD — BACKEND CONFIGURATION  (EXAMPLE FILE)
# ---------------------------------------------------------
#  This file is safe to commit: it holds PLACEHOLDERS ONLY.
#
#  To use it, make a copy called `.env` in the same folder:
#      Windows :  copy .env.example .env
#      Mac/Linux:  cp .env.example .env
#  then edit `.env` with YOUR real values.
#
#  `.env` is listed in .gitignore, so your real MySQL
#  password can never be committed by accident.
# =========================================================

# ---------- API server ----------
# Port the Express server listens on. The Vite dev server
# proxies /api/* to this port (see vite.config.ts).
PORT=4000

# "development" while you work, "production" when it is live.
NODE_ENV=development

# ---------- MySQL connection ----------
# These four values are read ONLY by server/db.js.
# They must never appear anywhere inside src/ (the frontend),
# because everything in src/ is sent to the browser.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-mysql-password-here
DB_NAME=safe_squad

# ---------- Login sessions ----------
# How long one login lasts before the student/admin must log
# in again (minutes). Sessions live in the server's memory.
SESSION_MINUTES=120

# Name of the session cookie. Changing it logs everybody out.
SESSION_COOKIE_NAME=safesquad_session

# Set to "true" ONLY when the site is served over HTTPS.
# Leave "false" for local development on http://localhost.
SESSION_COOKIE_SECURE=false
