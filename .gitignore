# =========================================================
# SAFE SQUAD — files that must never be committed to git
# ---------------------------------------------------------
# Everything listed here is either generated by a command
# (so it can always be rebuilt) or secret (so it must stay
# on your own computer only).
# =========================================================

# Installed npm packages — rebuilt with `npm install` / `npm ci`
node_modules/

# The production build produced by `npm run build`
dist/

# Old generated preview bundle (kept out of git; build to dist/ instead)
preview_build/

# Secret configuration, e.g. the MySQL password used by the backend.
# Never commit real credentials — share a .env.example instead.
.env

# Vite / editor local overrides, e.g. .env.local, tsconfig.tsbuildinfo.local
*.local

# Sensitive exports and database backups must not be committed.
backups/
*.sql.age
*.sql.gz
safe-squad-report*.csv
